# Server-side only. Enables live FRED-backed rates data in the backend provider.
FRED_API_KEY=

# Server-side only. Enables live OpenAI-backed agent responses; deterministic fallbacks run without it.
OPENAI_API_KEY=

# Server-side only. Alpha Vantage equity/ETF price and quote adapter.
# Either variable may hold the API key; ALPHA_VANTAGE_API_KEY is the explicit form.
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_API_KEY=
# Optional: delayed or realtime when the account is entitled to that feed.
ALPHA_VANTAGE_ENTITLEMENT=

# Reserved for a future server-side news/event provider. Never expose provider keys in browser code.
NEWS_PROVIDER_API_KEY=

# Public frontend URL used for metadata canonical/Open Graph URLs. Optional locally.
NEXT_PUBLIC_SITE_URL=

# Public frontend API base. Use /api for same-origin production behind Caddy.
NEXT_PUBLIC_API_BASE=
