# Server-side only. Enables live FRED-backed rates data in the backend provider.
FRED_API_KEY=

# Server-side only. Enables live OpenAI-backed agent responses; deterministic fallbacks run without it.
OPENAI_API_KEY=

# Reserved for future server-side provider adapters. Do not expose these in browser-delivered code.
NEWS_PROVIDER_API_KEY=
MARKET_DATA_API_KEY=

# Public frontend URL used for metadata canonical/Open Graph URLs. Optional locally.
NEXT_PUBLIC_SITE_URL=

# Public frontend API base. Use /api for same-origin production behind Caddy.
NEXT_PUBLIC_API_BASE=
