# Copy to .env on your private runtime host; never commit the populated file.
OSIRIS_DOMAIN=osiris.your-domain.example
OSIRIS_ALLOWED_ORIGINS=https://ballzatram.com
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use distinct codes for each invited pilot participant, separated by commas.
OSIRIS_PILOT_CODES=
