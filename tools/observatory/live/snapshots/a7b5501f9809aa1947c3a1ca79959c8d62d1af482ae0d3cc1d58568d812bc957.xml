    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2026-06-18</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2026-09-09T18:25:26Z</updateDate>
        <text><![CDATA[<p><strong>Providing Emotional Assistance with Relief and Love Act or the PEARL Act</strong></p><p>This bill requires U.S. Customs and Border Protection (CBP) to establish&nbsp;a pilot program to adopt dogs from local animal shelters to be trained as support dogs for CBP’s Support Canine Program. Support dogs are used for grief assistance, trauma mitigation, and morale.</p>]]></text>
      </summary>
    </summaries>
