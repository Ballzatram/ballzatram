FROM node:20-alpine

WORKDIR /app/frontend
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --include=dev

COPY frontend ./
# Keep the same sibling layout as the repository so shared CSS and public
# symlinks resolve in containers as well as local builds.
COPY data ../data
COPY assets ../assets
COPY games ../games
COPY econ-arcade ../econ-arcade
COPY tools ../tools
COPY devin ../devin
COPY style.css weather-bot.html weather-bot.js ../
COPY ai-edit-factory/index.html ai-edit-factory/style.css ai-edit-factory/README.md ../ai-edit-factory/

ARG NEXT_PUBLIC_API_BASE=/api
ARG GIT_COMMIT=unknown
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_GIT_COMMIT=$GIT_COMMIT

RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
