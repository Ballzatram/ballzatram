{
  "name": "ballzatram-osiris-tools",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/serve.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "npm run build && wrangler deploy --dry-run",
    "test:worker": "npm run build && node scripts/check-worker.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "wrangler": "4.160.1"
  }
}
